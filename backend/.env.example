# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Matches credentials in root docker-compose.yml
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/coding_harness?schema=public"

# Security & CORS
CORS_ORIGIN="*"

# Logging
LOG_LEVEL=info

# Redis Connection (Matches root docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & JWT
JWT_SECRET=coding-harness-dev-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Workspaces & Uploads Storage
WORKSPACES_DIR=/tmp/coding-harness/workspaces
UPLOADS_DIR=/tmp/coding-harness/uploads

# Docker Sandbox Execution Layer
# DOCKER_SOCKET_PATH=/var/run/docker.sock
SANDBOX_IMAGE=node:18-alpine
SANDBOX_MEMORY_LIMIT=536870912
SANDBOX_NANOCPUS=1000000000
COMMAND_TIMEOUT_MS=60000

# AI Agent & LLM Configuration (Phase 4)
AI_PROVIDER=openai
OPENAI_API_KEY=your-api-key-here
# AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AGENT_MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.2
