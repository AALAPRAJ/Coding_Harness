# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Matches credentials in root docker-compose.yml
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/coding_harness?schema=public"

# Security & CORS
CORS_ORIGIN="*"

# Logging
LOG_LEVEL=info

# Redis Connection (Matches root docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication & JWT
JWT_SECRET=coding-harness-dev-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Workspaces & Uploads Storage
WORKSPACES_DIR=/tmp/coding-harness/workspaces
UPLOADS_DIR=/tmp/coding-harness/uploads
