{
  "name": "@coding-harness/backend",
  "version": "1.0.0",
  "description": "Backend API Server and Orchestration Engine for Coding Harness",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "test": "tsx tests/run-all.ts",
    "test:db": "tsx tests/db.test.ts",
    "test:api": "tsx tests/api.test.ts",
    "test:phase3": "tsx tests/phase3.test.ts",
    "test:phase4": "tsx tests/phase4.test.ts",
    "test:env": "tsx tests/env.debug.ts"
  },
  "dependencies": {
    "@coding-harness/shared": "*",
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.12",
    "cors": "^2.8.5",
    "dockerode": "^5.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "openai": "^7.32.0",
    "simple-git": "^4.0.2",
    "unzipper": "^0.12.5",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.8.1",
    "@types/unzipper": "^0.10.11",
    "prisma": "^5.21.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
